	/// 1, jei ERP kliento kodas turėjo tarpų ar mažųjų raidžių ir buvo sutvarkytas.
	column 'Kodas taisytas'
		dataType: int64
		isHidden
		lineageTag: 8662dbcb-7c9f-4e79-bb4c-2c32126304b9
		sourceColumn: Kodas taisytas

	partition Pardavimai = m
		mode: import
		source =
				let
				    Failai = Folder.Files(#"Duomenų aplankas"),
				    MenesiuFailai = Table.SelectRows(Failai, each Text.Contains(Text.Lower([Folder Path]), "\raw\erp\pardavimai\") and Text.Lower([Extension]) = ".csv"),
				    Lenteles = Table.AddColumn(MenesiuFailai, "Duomenys", each Table.TransformColumnNames(Table.PromoteHeaders(Csv.Document([Content], [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]), each Text.Replace(_, "#(feff)", ""))),
				    Sujungta = Table.Combine(Lenteles[Duomenys]),
				    Tipai = Table.TransformColumnTypes(Sujungta, {{"SASKAITOS_NR", type text}, {"DATA", type date}, {"KLIENTO_KODAS", type text}, {"PREKES_KODAS", type text}, {"UZSAKYTA_VNT", Int64.Type}, {"PRISTATYTA_VNT", Int64.Type}, {"KAINA_EUR", type number}, {"NUOLAIDA_PROC", type number}, {"AKCIJA", type text}, {"SAVIKAINA_VNT_EUR", type number}}, "lt-LT"),
				    BeDublikatu = Table.Group(Tipai, Table.ColumnNames(Tipai), {{"ERP eilučių", each Table.RowCount(_), Int64.Type}}),
				    KodasTaisytas = Table.AddColumn(BeDublikatu, "Kodas taisytas", each let o = [KLIENTO_KODAS] ?? "" in if Text.Trim(o) <> "" and o <> Text.Upper(Text.Trim(o)) then 1 else 0, Int64.Type),
				    KlientoKodas = Table.AddColumn(KodasTaisytas, "Kliento kodas", each let k = Text.Upper(Text.Trim([KLIENTO_KODAS] ?? "")) in if k = "" then "NEŽINOMAS" else k, type text),
				    Akcija = Table.TransformColumns(KlientoKodas, {{"AKCIJA", each if _ = "T" then "Taip" else "Ne", type text}}),
				    Pajamos = Table.AddColumn(Akcija, "Pajamos", each [PRISTATYTA_VNT] * [KAINA_EUR] * (1 - [NUOLAIDA_PROC] / 100), type number),
				    Bruto = Table.AddColumn(Pajamos, "Pajamos be nuolaidų", each [PRISTATYTA_VNT] * [KAINA_EUR], type number),
				    Savikaina = Table.AddColumn(Bruto, "Žaliavų savikaina", each [PRISTATYTA_VNT] * [SAVIKAINA_VNT_EUR], type number),
				    PrarastaVnt = Table.AddColumn(Savikaina, "Prarasta vnt", each [UZSAKYTA_VNT] - [PRISTATYTA_VNT], Int64.Type),
				    PrarastosPajamos = Table.AddColumn(PrarastaVnt, "Prarastos pajamos", each [Prarasta vnt] * [KAINA_EUR] * (1 - [NUOLAIDA_PROC] / 100), type number),
				    Pervadinta = Table.RenameColumns(PrarastosPajamos, {{"SASKAITOS_NR", "Sąskaitos nr"}, {"DATA", "Data"}, {"KLIENTO_KODAS", "Kliento kodas (ERP)"}, {"PREKES_KODAS", "Prekės kodas"}, {"UZSAKYTA_VNT", "Užsakyta vnt"}, {"PRISTATYTA_VNT", "Pristatyta vnt"}, {"KAINA_EUR", "Kainoraščio kaina"}, {"NUOLAIDA_PROC", "Nuolaida %"}, {"AKCIJA", "Akcija"}, {"SAVIKAINA_VNT_EUR", "Savikaina vnt"}})
				in
				    Pervadinta

