/// Kalendorius 2025-01-01 – 2026-10-31. Pažymėtas kaip datų lentelė.
table Data
	lineageTag: 3f0779fb-f00f-498a-a218-b9a450eaf465
	dataCategory: Time

	column Data
		isUnique
		formatString: yyyy-mm-dd
		lineageTag: 6adf4145-2042-44a0-bfa9-b38239daec67
		isNameInferred
		sourceColumn: [Data]

	column Metai
		lineageTag: 0c7df90e-dd21-44be-af5b-20a0e24ef4e2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Metai]

	column 'Mėnesio nr'
		isHidden
		lineageTag: c137539f-da64-4998-9d7e-4a6e7fb9dcb2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mėnesio nr]

	column Mėnuo
		lineageTag: 85a57d9a-2ced-472b-9f1e-b322fed03399
		isNameInferred
		sourceColumn: [Mėnuo]
		sortByColumn: 'Mėnesio nr'

	column Metai-mėnuo
		lineageTag: 12b206fb-b08a-4bcd-b68c-1a230db1a6f1
		isNameInferred
		sourceColumn: [Metai-mėnuo]

	column 'Metai-mėnuo nr'
		isHidden
		lineageTag: c0820eb9-6db2-4e66-a4c1-895c9d92456c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Metai-mėnuo nr]

	column Ketvirtis
		lineageTag: 09358dfe-6ab1-4551-8d21-51c71db505db
		isNameInferred
		sourceColumn: [Ketvirtis]

	column 'Savaitės pradžia'
		formatString: yyyy-mm-dd
		lineageTag: 3745a45c-dd2b-4c8b-88ff-df760df76f95
		isNameInferred
		sourceColumn: [Savaitės pradžia]

	column 'Savaitės dienos nr'
		isHidden
		lineageTag: d98297a1-a386-40b0-924b-5c692b448d50
		summarizeBy: none
		isNameInferred
		sourceColumn: [Savaitės dienos nr]

	column Sezonas
		lineageTag: 3dde0e9a-66e6-478c-b946-bdbe3a6ede0b
		isNameInferred
		sourceColumn: [Sezonas]

	column 'Mėnesio pabaiga'
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 2af382ed-3734-42c0-822a-57ff091b3c1b
		isNameInferred
		sourceColumn: [Mėnesio pabaiga]

	partition Data = calculated
		mode: import
		source =
				VAR Kalendorius = SELECTCOLUMNS(CALENDAR(DATE(2025, 1, 1), DATE(2026, 10, 31)), "Data", [Date])
				RETURN
				    ADDCOLUMNS(
				        Kalendorius,
				        "Metai", YEAR([Data]),
				        "Mėnesio nr", MONTH([Data]),
				        "Mėnuo", SWITCH(MONTH([Data]), 1, "Sausis", 2, "Vasaris", 3, "Kovas", 4, "Balandis", 5, "Gegužė", 6, "Birželis", 7, "Liepa", 8, "Rugpjūtis", 9, "Rugsėjis", 10, "Spalis", 11, "Lapkritis", 12, "Gruodis"),
				        "Metai-mėnuo", FORMAT([Data], "yyyy-MM"),
				        "Metai-mėnuo nr", YEAR([Data]) * 100 + MONTH([Data]),
				        "Ketvirtis", "K" & QUARTER([Data]),
				        "Savaitės pradžia", [Data] - WEEKDAY([Data], 3),
				        "Savaitės dienos nr", WEEKDAY([Data], 2),
				        "Sezonas", IF(MONTH([Data]) IN {5, 6, 7, 8}, "Vasaros sezonas (V–VIII)", "Ne sezonas"),
				        "Mėnesio pabaiga", EOMONTH([Data], 0)
				    )

