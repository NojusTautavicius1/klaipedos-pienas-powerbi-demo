/// Kiekviena DI nuskaityta PDF sąskaita: statusas, priežastys, modelis, tokenai, kaina ir trukmė (di_zurnalas.csv).
table 'DI žurnalas'
	lineageTag: 929779db-15af-4240-b27e-c150e5376077

	column Failas
		dataType: string
		lineageTag: 571c04df-b8e4-4382-b826-fc9ae3a58ff8
		sourceColumn: Failas

	column Statusas
		dataType: string
		lineageTag: 23701fc9-1ab2-4b49-9f51-9649123a3871
		sourceColumn: Statusas

	column Priežastys
		dataType: string
		lineageTag: 81485665-42b7-410a-bde7-e9b4917e9756
		sourceColumn: Priežastys

	column Modelis
		dataType: string
		lineageTag: cd456966-7325-46c6-b223-c10a12a4b49f
		sourceColumn: Modelis

	column 'Įvesties tokenai'
		dataType: int64
		formatString: #,0
		lineageTag: a519d32f-111a-4e88-9de0-de116146783c
		sourceColumn: Įvesties tokenai

	column 'Išvesties tokenai'
		dataType: int64
		formatString: #,0
		lineageTag: 08d472cc-d7ed-4492-ae97-a8f4d94e5481
		sourceColumn: Išvesties tokenai

	column 'Kaina USD'
		dataType: double
		formatString: 0.0000
		lineageTag: 4c067984-0c85-4614-9ea9-8f6540377a88
		sourceColumn: Kaina USD

	column 'Trukmė s'
		dataType: double
		formatString: 0.0
		lineageTag: 2be60d63-ec21-414f-a542-f9526cc0d26b
		sourceColumn: Trukmė s

	column Apdorota
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: 117f24a5-1523-4535-a75d-9c7b08f0b271
		sourceColumn: Apdorota

	partition 'DI žurnalas' = m
		mode: import
		source =
				let
				    Failai = Folder.Files(#"Duomenų aplankas"),
				    Turinys = Table.SelectRows(Failai, each Text.EndsWith(Text.Lower([Folder Path] & [Name]), "\clean\di_zurnalas.csv")){0}[Content],
				    Csv = Csv.Document(Turinys, [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Antrastes = Table.TransformColumnNames(Table.PromoteHeaders(Csv, [PromoteAllScalars = true]), each Text.Replace(_, "#(feff)", "")),
				    Tipai = Table.TransformColumnTypes(Antrastes, {{"FAILAS", type text}, {"STATUSAS", type text}, {"PRIEZASTYS", type text}, {"MODELIS", type text}, {"IVESTIES_TOKENAI", Int64.Type}, {"ISVESTIES_TOKENAI", Int64.Type}, {"KAINA_USD", type number}, {"TRUKME_S", type number}, {"APDOROTA", type datetime}}, "lt-LT"),
				    Pervadinta = Table.RenameColumns(Tipai, {{"FAILAS", "Failas"}, {"STATUSAS", "Statusas"}, {"PRIEZASTYS", "Priežastys"}, {"MODELIS", "Modelis"}, {"IVESTIES_TOKENAI", "Įvesties tokenai"}, {"ISVESTIES_TOKENAI", "Išvesties tokenai"}, {"KAINA_USD", "Kaina USD"}, {"TRUKME_S", "Trukmė s"}, {"APDOROTA", "Apdorota"}})
				in
				    Pervadinta

