/// Žaliavų sąrašas (zaliavos.csv).
table Žaliava
	lineageTag: f54fc28c-efa5-4fb3-9170-d235e4e06291

	column 'Žaliavos kodas'
		dataType: string
		lineageTag: ff347e12-b033-42b7-b9b2-89ef21b7bd12
		sourceColumn: Žaliavos kodas

	column Žaliava
		dataType: string
		lineageTag: 4df4cb3d-88b3-4b81-846b-b2a0abe3d173
		sourceColumn: Žaliava

	column Matas
		dataType: string
		lineageTag: 67560c60-2729-4aec-875e-ca19b6ab60df
		sourceColumn: Matas

	column 'Pagrindinio tiekėjo kodas'
		dataType: string
		lineageTag: 3544c520-64cb-49c2-bd14-a16a52a54ee7
		sourceColumn: Pagrindinio tiekėjo kodas

	partition Žaliava = m
		mode: import
		source =
				let
				    Failai = Folder.Files(#"Duomenų aplankas"),
				    Turinys = Table.SelectRows(Failai, each Text.EndsWith(Text.Lower([Folder Path] & [Name]), "\raw\erp\zaliavos.csv")){0}[Content],
				    Csv = Csv.Document(Turinys, [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Antrastes = Table.TransformColumnNames(Table.PromoteHeaders(Csv, [PromoteAllScalars = true]), each Text.Replace(_, "#(feff)", "")),
				    Tipai = Table.TransformColumnTypes(Antrastes, {{"ZALIAVOS_KODAS", type text}, {"PAVADINIMAS", type text}, {"MATAS", type text}, {"TIEKEJO_KODAS", type text}}),
				    Pervadinta = Table.RenameColumns(Tipai, {{"ZALIAVOS_KODAS", "Žaliavos kodas"}, {"PAVADINIMAS", "Žaliava"}, {"MATAS", "Matas"}, {"TIEKEJO_KODAS", "Pagrindinio tiekėjo kodas"}})
				in
				    Pervadinta

