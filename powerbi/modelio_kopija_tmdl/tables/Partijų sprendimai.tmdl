/// Kokybės specialisto sprendimai partijoms su nuokrypiais (partiju_sprendimai.csv).
table 'Partijų sprendimai'
	lineageTag: 8388a724-6a35-4b47-bf30-8edeace6719d

	column 'Partijos nr'
		dataType: string
		isHidden
		lineageTag: 0c2496bd-9cf5-425d-a678-be8f060db083
		sourceColumn: Partijos nr

	column Sprendimas
		dataType: string
		lineageTag: abbcd596-e584-4f63-9c62-efd05a8201f0
		sourceColumn: Sprendimas

	column 'Sprendimo data'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 27a6970f-6b78-4420-bfc3-8652a1248ad4
		sourceColumn: Sprendimo data

	column Nuokrypiai
		dataType: string
		lineageTag: dda5a72d-6c9c-4374-821c-ddd65f24c69c
		sourceColumn: Nuokrypiai

	column Atsakingas
		dataType: string
		lineageTag: e24ff7a3-2701-4e65-bf5e-bfdc116007bf
		sourceColumn: Atsakingas

	partition 'Partijų sprendimai' = m
		mode: import
		source =
				let
				    Failai = Folder.Files(#"Duomenų aplankas"),
				    Turinys = Table.SelectRows(Failai, each Text.EndsWith(Text.Lower([Folder Path] & [Name]), "\raw\kokybe\partiju_sprendimai.csv")){0}[Content],
				    Csv = Csv.Document(Turinys, [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Antrastes = Table.TransformColumnNames(Table.PromoteHeaders(Csv, [PromoteAllScalars = true]), each Text.Replace(_, "#(feff)", "")),
				    Tipai = Table.TransformColumnTypes(Antrastes, {{"PARTIJOS_NR", type text}, {"SPRENDIMAS", type text}, {"SPRENDIMO_DATA", type date}, {"PRIEZASTYS", type text}, {"ATSAKINGAS", type text}}),
				    Pervadinta = Table.RenameColumns(Tipai, {{"PARTIJOS_NR", "Partijos nr"}, {"SPRENDIMAS", "Sprendimas"}, {"SPRENDIMO_DATA", "Sprendimo data"}, {"PRIEZASTYS", "Nuokrypiai"}, {"ATSAKINGAS", "Atsakingas"}})
				in
				    Pervadinta

